<%# locals: (dashboard:) %>
<% if dashboard.gifts_to_choose.any? %>
  <section aria-labelledby="gifts-to-choose-heading" class="section">
    <%= section_header t(".heading"), id: "gifts-to-choose-heading" %>

    <ul class="card card--flush list">
      <% dashboard.gifts_to_choose.each do |choice| %>
        <li>
          <article aria-label="<%= t(".label", occasion: occasion_title(choice.occasion)) %>" class="px-5 py-4 sm:px-6">
            <div class="flex items-center gap-4">
              <%= render "occasions/date_badge", date: choice.occasion.date %>
              <div class="min-w-0 flex-1">
                <p class="row-title"><%= occasion_title(choice.occasion) %></p>
                <p class="row-meta">
                  <%= countdown_to(choice.occasion.date) %><% if choice.occasion.custom? %> · <%= choice.occasion.group.name %><% end %>
                </p>
              </div>
            </div>

            <%= render "occasions/still_to_choose", choice: %>
          </article>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
