<% content_for :title, t(".title") %>

<div class="page page--single">
  <%= page_header t(".title"), crumbs: [ [ t("layouts.header.home"), root_path ], [ t(".your_details"), edit_person_profile_path(Current.user) ] ],
        subtitle: t(".intro") %>

  <div class="card">
    <ul class="grid list-disc gap-2 pl-5 text-base">
      <% account_deletion_consequences_for(Current.user).each do |consequence| %>
        <li><%= consequence %></li>
      <% end %>
    </ul>

    <%= form_with url: account_deletion_path, class: "mt-6 border-t border-line pt-6" do |form| %>
      <%= render "shared/password_field", form:, field: :password, autocomplete: "current-password", label: t(".password") %>

      <div class="form-actions">
        <%= form.submit t(".submit"), class: "button button--danger button--wide" %>
      </div>
    <% end %>
  </div>
</div>
