<% content_for :title, t(".title") %>

<div class="page page--centered">
  <%= page_header t(".heading") %>

  <div class="card">
    <%= form_with url: session_path do |form| %>
      <div class="fields">
        <div class="field">
          <%= form.label :email_address, t(".email_address"), class: "label" %>
          <%= form.email_field :email_address, value: params[:email_address], required: true, autocomplete: "username",
                autofocus: params[:email_address].blank?, class: "input" %>
        </div>

        <%= render "shared/password_field", form:, field: :password, autocomplete: "current-password", label: t(".password") %>
      </div>

      <div class="form-actions">
        <%= form.submit t(".submit"), class: "button w-full" %>
      </div>
    <% end %>

    <p class="hint mt-5"><%= t(".forgotten") %></p>
  </div>

  <p class="mt-6 text-center text-base text-muted">
    <%= t(".new_here") %>
    <%= link_to t(".create_account"), new_registration_path, class: "link" %>
  </p>
</div>
