<%# locals: (form:, field:, autocomplete:, label:, hint: nil) %>
<div data-controller="password-reveal" data-password-reveal-show-value="<%= t(".show") %>" data-password-reveal-hide-value="<%= t(".hide") %>">
  <%= form.label field, label, class: "label" %>
  <div class="relative">
    <%= form.password_field field, required: true, autocomplete:, class: "input pr-24",
          data: { password_reveal_target: "input" }, aria: { describedby: ("#{field}-hint" if hint.present?) } %>
    <button type="button" class="absolute inset-y-1.5 right-1.5 rounded-xl px-4 font-semibold text-muted hover:bg-paper hover:text-ink"
            data-password-reveal-target="button" data-action="password-reveal#toggle" aria-pressed="false">
      <%= t(".show") %>
    </button>
  </div>
  <% if hint.present? %>
    <p id="<%= field %>-hint" class="hint"><%= hint %></p>
  <% end %>
</div>
