<%# locals: (title:, crumbs:, subtitle:, avatar:, actions:) %>
<header class="page-header">
  <% if crumbs.any? %>
    <nav aria-label="<%= t(".breadcrumb") %>" class="crumbs">
      <% crumbs.each_with_index do |(label, path), index| %>
        <% if index.positive? %><span aria-hidden="true">›</span><% end %>
        <%= link_to label, path %>
      <% end %>
    </nav>
  <% end %>

  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
    <div class="flex min-w-0 flex-[1_1_15rem] items-center gap-3">
      <%= avatar %>
      <div class="min-w-0">
        <h1 class="page-title"><%= title %></h1>
        <% if subtitle.present? %>
          <div class="page-subtitle"><%= subtitle %></div>
        <% end %>
      </div>
    </div>
    <% if actions.present? %>
      <div class="flex shrink-0 flex-wrap items-center gap-2"><%= actions %></div>
    <% end %>
  </div>
</header>
