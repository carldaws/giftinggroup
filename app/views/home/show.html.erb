<% content_for :title, t(".title") %>
<% alice = sample_person(t(".demo.alice"), tone: "sage", character: "fox") %>
<% bob = sample_person(t(".demo.bob"), tone: "honey") %>
<% carol = sample_person(t(".demo.carol"), tone: "plum", character: "owl") %>
<% rebecca = sample_person(t(".demo.rebecca"), tone: "clay", character: "chick") %>
<% christmas = Holiday.find("christmas_day") %>

<div class="page">
  <section class="mt-8 mb-12 max-w-2xl sm:mt-12">
    <h1 class="page-title"><%= t(".heading") %></h1>
    <p class="mt-3 text-muted"><%= t(".intro") %></p>
    <div class="mt-6 flex flex-wrap gap-3">
      <%= link_to t(".create_account"), new_registration_path, class: "button" %>
      <%= link_to t(".sign_in"), new_session_path, class: "button button--secondary" %>
    </div>
    <p class="mt-4 text-base text-muted"><%= t(".invited") %></p>
  </section>

  <section aria-labelledby="how-heading" class="section">
    <%= section_header t(".how_heading"), id: "how-heading" %>

    <ol class="grid gap-4">
      <%= render "home/step", number: 1, name: "group", demo: capture { %>
        <div class="card">
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="row-title"><%= t(".demo.group") %></p>
              <p class="row-meta"><%= t("groups.index.people", count: 4) %></p>
            </div>
            <div class="avatar-stack">
              <% [ alice, bob, carol, rebecca ].each do |person| %>
                <%= avatar_tag person, size: :sm, tooltip: false %>
              <% end %>
            </div>
          </div>
          <div class="mt-4 flex items-center justify-between gap-3">
            <span class="inset font-mono text-sm tracking-wider"><%= t(".demo.code") %></span>
            <span class="button button--secondary button--small"><%= t("groups.show.copy") %></span>
          </div>
        </div>
      <% } %>

      <%= render "home/step", number: 2, name: "list", demo: capture { %>
        <div class="card card--flush">
          <div class="p-5 sm:p-6">
            <span class="badge badge--honey"><%= t("items.item.most_wanted") %></span>
            <p class="mt-2 text-lg font-semibold"><%= t(".demo.scarf") %></p>
            <p class="row-meta"><%= t(".demo.scarf_price") %></p>
            <p class="mt-2 text-base"><%= t(".demo.scarf_notes") %></p>
          </div>
          <div class="card-footer">
            <p class="mb-2 text-sm text-muted"><%= t("people.interests.heading", name: alice.name) %></p>
            <div class="flex flex-wrap gap-2">
              <span class="tag"><%= t(".demo.love_walking") %></span>
              <span class="tag"><%= t(".demo.love_chocolate") %></span>
            </div>
          </div>
        </div>
      <% } %>

      <%= render "home/step", number: 3, name: "pick", demo: capture { %>
        <div class="card card--flush">
          <p class="px-5 pt-5 text-lg font-semibold sm:px-6"><%= t(".demo.scarf") %></p>
          <p class="row-meta px-5 pb-4 sm:px-6"><%= t(".demo.for_alice") %></p>
          <div class="card-footer grid gap-3">
            <span class="chip w-fit">
              <%= avatar_tag bob, size: :sm, tooltip: false, ring: false %>
              <%= t("items.item.status.you_getting_for", occasion: christmas.name) %>
            </span>
            <div class="flex flex-wrap gap-2">
              <span class="button button--small"><%= t("items.item.bought_it") %></span>
              <span class="button button--secondary button--small"><%= t("items.item.let_go") %></span>
            </div>
          </div>
        </div>
        <p class="mt-3 text-sm text-muted"><%= t(".demo.hidden_from", name: alice.name) %></p>
      <% } %>

      <%= render "home/step", number: 4, name: "ideas", demo: capture { %>
        <div class="card">
          <span class="badge badge--plum"><%= t("items.item.idea_from", name: carol.name) %></span>
          <p class="mt-2 text-lg font-semibold"><%= t(".demo.gloves") %></p>
          <p class="row-meta"><%= t(".demo.for_alice") %></p>
        </div>
      <% } %>

      <%= render "home/step", number: 5, name: "chat", demo: capture { %>
        <div class="card grid gap-3">
          <p class="text-sm font-semibold text-muted"><%= t("groups.memberships.messages.index.heading", name: alice.name) %></p>
          <div class="flex items-end gap-2">
            <%= avatar_tag carol, size: :sm, tooltip: false, ring: false %>
            <p class="max-w-[85%] rounded-2xl rounded-bl-md bg-hover px-4 py-2.5 text-base"><%= t(".demo.chat_question") %></p>
          </div>
          <p class="ml-auto max-w-[85%] rounded-2xl rounded-br-md bg-accent px-4 py-2.5 text-base text-on-accent"><%= t(".demo.chat_answer") %></p>
        </div>
      <% } %>

      <%= render "home/step", number: 6, name: "occasions", demo: capture { %>
        <div class="card">
          <div class="flex items-center gap-4">
            <%= render "occasions/date_badge", date: christmas.next_date %>
            <div>
              <p class="row-title"><%= christmas.name %></p>
              <p class="row-meta"><%= countdown_to(christmas.next_date) %></p>
            </div>
          </div>
          <p class="mt-4 mb-2 text-base text-muted"><%= t("occasions.still_to_choose.heading") %></p>
          <div class="flex flex-wrap gap-2">
            <% [ carol, rebecca ].each do |person| %>
              <span class="chip">
                <%= avatar_tag person, size: :sm, tooltip: false, ring: false %>
                <%= person.name %>
              </span>
            <% end %>
          </div>
        </div>
      <% } %>

      <%= render "home/step", number: 7, name: "looked_after", demo: capture { %>
        <div class="card card--flush">
          <div class="row">
            <%= avatar_tag rebecca, tooltip: false %>
            <div>
              <p class="row-title"><%= rebecca.name %></p>
              <p class="row-meta"><%= t("groups.membership.looked_after_by", names: t(".demo.you")) %></p>
            </div>
          </div>
          <div class="card-footer text-base text-muted"><%= t("groups.membership.set_up_link") %></div>
        </div>
      <% } %>

      <%= render "home/step", number: 8, name: "shopping", demo: capture { %>
        <div class="card card--flush list">
          <div class="row">
            <%= avatar_tag alice, tooltip: false %>
            <div class="min-w-0 flex-1">
              <p class="row-title"><%= t(".demo.scarf") %></p>
              <p class="row-meta"><%= t("groups.shopping_list.for", name: alice.name) %></p>
            </div>
            <span class="button button--secondary button--small"><%= t("groups.shopping_list.bought") %></span>
          </div>
          <div class="row">
            <%= avatar_tag rebecca, tooltip: false %>
            <div class="min-w-0 flex-1">
              <p class="row-title"><%= t(".demo.book") %></p>
              <p class="row-meta"><%= t("groups.shopping_list.for", name: rebecca.name) %></p>
            </div>
            <span class="button button--secondary button--small"><%= t("groups.shopping_list.bought") %></span>
          </div>
        </div>
      <% } %>
    </ol>
  </section>

  <section aria-labelledby="free-heading" class="card mb-4 text-center">
    <h2 id="free-heading" class="section-title"><%= t(".free_heading") %></h2>
    <p class="mt-2 text-base text-muted"><%= t(".free_body") %></p>
    <div class="mt-5 flex flex-wrap justify-center gap-3">
      <%= link_to t(".create_account"), new_registration_path, class: "button" %>
      <%= link_to t(".sign_in"), new_session_path, class: "button button--secondary" %>
    </div>
  </section>
</div>
