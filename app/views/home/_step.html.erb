<%# locals: (number:, name:, demo:) %>
<li class="card grid gap-6 md:grid-cols-2 md:items-center md:gap-10">
  <div>
    <h3 class="section-title flex items-center gap-3 font-display">
      <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-clay-tint font-sans text-sm font-semibold text-clay-ink"><%= number %></span>
      <%= t("home.show.steps.#{name}.heading") %>
    </h3>
    <p class="mt-3 text-base text-muted"><%= t("home.show.steps.#{name}.body") %></p>
  </div>
  <div class="pointer-events-none rounded-2xl bg-paper p-4 select-none sm:p-5" aria-hidden="true">
    <%= demo %>
  </div>
</li>
