<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [ content_for(:title), t("app.name") ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#fbf6f0" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1e1a17" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400..700&family=Fraunces:opsz,wght,SOFT@9..144,400..700,0..100&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-dvh">
    <% if authenticated? %>
      <header class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 pt-[max(1rem,env(safe-area-inset-top))] pb-4 sm:px-6">
        <%= link_to root_path, class: "no-underline" do %>
          <%= render "layouts/wordmark" %>
        <% end %>

        <div class="flex items-center gap-3">
          <span class="hidden text-muted sm:inline"><%= Current.user.name %></span>
          <%= button_to t(".sign_out"), session_path, method: :delete, class: "button button--quiet min-h-10 px-4 text-base" %>
        </div>
      </header>
    <% else %>
      <%= render "layouts/masthead" %>
    <% end %>

    <main class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
      <%= render "layouts/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
