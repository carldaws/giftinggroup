<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [ content_for(:title), t("app.name") ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#2a2420" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400..700&family=Fraunces:opsz,wght,SOFT@9..144,400..700,0..100&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-dvh flex-col">
    <header class="sticky top-0 z-40 border-b border-line bg-card/95 pt-[env(safe-area-inset-top)] backdrop-blur">
      <div class="page flex h-16 items-center justify-between gap-3 px-4 sm:px-6">
        <%= link_to root_path, class: "no-underline", aria: { label: t("layouts.header.home") } do %>
          <%= render "layouts/wordmark" %>
        <% end %>

        <% if authenticated? %>
          <div class="flex items-center gap-1">
            <%= render "layouts/groups_menu" %>
            <%= render "layouts/account_menu" %>
          </div>
        <% else %>
          <%= render "layouts/signed_out_nav" %>
        <% end %>
      </div>
    </header>

    <% if content_for?(:crumbs) %>
      <nav aria-label="<%= t(".breadcrumb") %>" class="mt-2 border-y border-line bg-card/95">
        <div class="page crumbs"><%= yield :crumbs %></div>
      </nav>
    <% end %>

    <main class="page flex-1 px-4 pb-16 sm:px-6">
      <%= render "layouts/flash" %>
      <%= yield %>
    </main>

    <%= render "layouts/footer" %>
  </body>
</html>
