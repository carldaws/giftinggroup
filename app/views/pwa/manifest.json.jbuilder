json.name t("app.name")
json.short_name t("app.name")
json.description t("app.description")
json.icons [
  { src: "/icon.png", type: "image/png", sizes: "512x512" },
  { src: "/icon.png", type: "image/png", sizes: "512x512", purpose: "maskable" }
]
json.start_url "/"
json.scope "/"
json.display "standalone"
json.theme_color "#ffffff"
json.background_color "#fbf6f0"
