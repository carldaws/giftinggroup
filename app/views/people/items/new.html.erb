<% content_for :title, @item.surprise? ? t(".suggest_title", name: @person.name) : t(".title") %>

<div class="page page--single">
  <%= page_header new_item_heading(@item), crumbs: [ [ t("layouts.header.home"), root_path ], [ @person.name, person_path(@person) ] ], subtitle: t(".intro") %>

  <div class="card">
    <%= render "items/form", item: @item, url: person_items_path(@person), submit: @item.surprise? ? t(".suggest_submit") : t(".submit") %>
  </div>
</div>
