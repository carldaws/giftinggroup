<% yours = @person == Current.user %>
<% manages = Current.user.looks_after?(@person) %>
<% items = @person.items.visible_to(Current.user).includes(:suggested_by, photos_attachments: { blob: { variant_records: { image_attachment: :blob } } }).in_list_order %>
<% wanted = items.wanted %>
<% little_only = params[:show] == "little" %>
<% shown = little_only ? wanted.little : wanted %>
<% reservations = yours ? {} : Reservation.visible_to(Current.user).where(item: shown).includes(:user).group_by(&:item_id) %>
<% content_for :title, @person.name %>

<div class="mt-6 flex items-center gap-4 <%= manages ? "mb-4" : "mb-10" %>">
  <%= avatar_tag @person, size: "size-16 text-xl" %>
  <div class="min-w-0">
    <h1 class="text-4xl font-semibold break-words"><%= @person.name %></h1>
    <% if yours %>
      <p class="text-muted"><%= t(".this_is_you") %></p>
    <% elsif manages %>
      <p class="text-muted"><%= t(".you_look_after", name: @person.name) %></p>
    <% end %>
    <% if @person.birthday? && !yours %>
      <p class="text-muted"><%= t(".birthday", date: l(@person.next_birthday, format: "%-d %B"), countdown: countdown_to(@person.next_birthday).downcase_first) %></p>
    <% end %>
  </div>
</div>

<% if manages %>
  <%= render "people/details", person: @person, yours: %>
<% end %>

<%= render "people/interests", person: @person, yours:, manages: %>
<%= render "people/sizes", person: @person, manages: %>

<section id="list" aria-labelledby="list-heading" class="mb-10">
  <h2 id="list-heading" class="text-2xl font-semibold"><%= yours ? t(".your_list") : t(".their_list", name: @person.name) %></h2>
  <p class="mb-5 text-muted"><%= yours ? t(".surprise_note") : t(".list_intro", name: @person.name) %></p>

  <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
    <nav aria-label="<%= t(".filter") %>" class="inline-flex gap-1 rounded-full bg-line/50 p-1">
      <%= link_to person_path(@person, anchor: "list"), class: "tab", aria: { current: ("page" unless little_only) } do %>
        <%= t(".everything") %> <span class="text-muted"><%= wanted.size %></span>
      <% end %>
      <%= link_to person_path(@person, show: "little", anchor: "list"), class: "tab", aria: { current: ("page" if little_only) } do %>
        <%= t(".little_things") %> <span class="text-muted"><%= wanted.little.size %></span>
      <% end %>
    </nav>

    <%= link_to (manages ? t(".add_item") : t(".suggest_item")), new_person_item_path(@person, little: (1 if little_only)), class: "button button--small" %>
  </div>

  <% if little_only %>
    <p class="mb-4 text-muted"><%= t(".little_things_intro") %></p>
  <% end %>

  <% if shown.any? %>
    <ul class="grid gap-4">
      <% shown.each do |item| %>
        <%= render "items/item", item:, reservations: reservations.fetch(item.id, []), yours: %>
      <% end %>
    </ul>
  <% elsif little_only %>
    <p class="card text-muted"><%= manages ? t(".little_empty_yours") : t(".little_empty", name: @person.name) %></p>
  <% else %>
    <p class="card text-muted"><%= manages ? t(".list_empty_yours") : t(".list_empty", name: @person.name) %></p>
  <% end %>
</section>

<% if manages %>
  <% received = items.received.where(suggested_by: nil) %>
  <% if received.any? %>
    <details class="mb-10">
      <summary class="cursor-pointer text-lg font-semibold"><%= t(".received", count: received.size) %></summary>
      <ul class="mt-4 grid gap-2">
        <% received.each do |item| %>
          <li class="flex items-center justify-between gap-4 rounded-2xl border border-line bg-card px-5 py-3">
            <span class="text-muted line-through"><%= item.name %></span>
            <%= button_to t(".put_back"), item_receipt_path(item), method: :delete, class: "button button--quiet button--small" %>
          </li>
        <% end %>
      </ul>
    </details>
  <% end %>
<% end %>
