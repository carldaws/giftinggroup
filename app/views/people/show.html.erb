<div class="page">
  <%= page_header @wishlist.person.name, crumbs: [ [ t("layouts.header.home"), root_path ] ], subtitle: next_birthday_of(@wishlist.person),
        avatar: avatar_tag(@wishlist.person, tooltip: false) do %>
    <% unless @wishlist.surprises_hidden? %>
      <%= render "people/chats", wishlist: @wishlist %>
    <% end %>
    <% if @wishlist.looked_after? %>
      <%= link_to edit_person_profile_path(@wishlist.person), class: "icon-button icon-button--outlined group", aria: { label: details_label_for(@wishlist) } do %>
        <svg viewBox="0 0 20 20" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 3.5l3 3L7 16H4v-3l9.5-9.5Z"/></svg>
        <span class="tooltip" aria-hidden="true"><%= details_label_for(@wishlist) %></span>
      <% end %>
    <% end %>
    <% if @wishlist.surprises_toggle? %>
      <%= link_to wishlist_path(@wishlist, surprises_shown: @wishlist.surprises_hidden?),
            class: "icon-button icon-button--outlined group", aria: { label: surprises_toggle_label_for(@wishlist) }, data: { turbo_action: "replace" } do %>
        <% if @wishlist.surprises_hidden? %>
          <svg viewBox="0 0 20 20" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8.5c2 3 4.5 4.5 7.5 4.5s5.5-1.5 7.5-4.5M10 13v2.5M5.5 11.8l-1.4 2M14.5 11.8l1.4 2"/></svg>
        <% else %>
          <svg viewBox="0 0 20 20" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 10s3-5.5 8-5.5 8 5.5 8 5.5-3 5.5-8 5.5S2 10 2 10Z"/><circle cx="10" cy="10" r="2.5"/></svg>
        <% end %>
        <span class="tooltip" aria-hidden="true"><%= surprises_toggle_label_for(@wishlist) %></span>
      <% end %>
    <% end %>
  <% end %>

  <div class="columns">
    <section id="list" aria-labelledby="list-heading" class="section min-w-0">
      <%= section_header list_heading_for(@wishlist), id: "list-heading" do %>
        <%= link_to add_item_label_for(@wishlist), new_person_item_path(@wishlist.person, little: (1 if @wishlist.little_only?)), class: "button button--small" %>
      <% end %>

      <nav aria-label="<%= t(".filter") %>" class="tabs mb-4">
        <%= link_to wishlist_path(@wishlist, little: false, anchor: "list"), class: "tab", aria: { current: ("page" unless @wishlist.little_only?) } do %>
          <%= t(".everything") %> <span class="text-muted"><%= @wishlist.wanted_count %></span>
        <% end %>
        <%= link_to wishlist_path(@wishlist, little: true, anchor: "list"), class: "tab", aria: { current: ("page" if @wishlist.little_only?) } do %>
          <%= t(".little_things") %> <span class="text-muted"><%= @wishlist.little_count %></span>
        <% end %>
      </nav>

      <% if @wishlist.little_only? %>
        <p class="mb-4 text-base text-muted"><%= t(".little_things_intro") %></p>
      <% end %>

      <% if @wishlist.passed_occasion.present? %>
        <p class="notice notice--honey mb-4"><%= passed_occasion_notice_for(@wishlist) %></p>
      <% end %>

      <% if @wishlist.cards.any? %>
        <ul class="grid gap-4">
          <%= render partial: "items/item", collection: @wishlist.still_wanted_cards, as: :card %>
        </ul>

        <% if @wishlist.given_cards.any? %>
          <details class="card card--flush mt-4">
            <summary class="row row--link cursor-pointer list-none font-semibold [&::-webkit-details-marker]:hidden"><%= t(".given", count: @wishlist.given_cards.size) %></summary>
            <ul class="grid gap-4 border-t border-line p-4">
              <%= render partial: "items/item", collection: @wishlist.given_cards, as: :card %>
            </ul>
          </details>
        <% end %>
      <% else %>
        <p class="card empty"><%= empty_list_message_for(@wishlist) %></p>
      <% end %>
    </section>

    <aside class="min-w-0">
      <%= render "people/interests", person: @wishlist.person, yours: @wishlist.yours?, manages: @wishlist.looked_after? %>
      <%= render "people/sizes", person: @wishlist.person, manages: @wishlist.looked_after? %>

      <% if @wishlist.received.any? %>
        <section aria-labelledby="received-heading" class="section">
          <%= section_header t(".received", count: @wishlist.received.size), id: "received-heading" %>
          <ul class="card card--flush list">
            <% @wishlist.received.each do |item| %>
              <li class="row">
                <span class="min-w-0 flex-1 text-muted line-through"><%= item.title %></span>
                <%= button_to t(".put_back"), item_receipt_path(item), method: :delete, class: "button button--secondary button--small" %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </aside>
  </div>
</div>
