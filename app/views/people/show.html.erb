<% yours = @person == Current.user %>
<% manages = Current.user.looks_after?(@person) %>
<% items = @person.items.visible_to(Current.user).includes(:suggested_by, photos_attachments: { blob: { variant_records: { image_attachment: :blob } } }).in_list_order %>
<% wanted = items.wanted %>
<% little_only = params[:show] == "little" %>
<% shown = little_only ? wanted.little : wanted %>
<% reservations = yours ? {} : Reservation.visible_to(Current.user).where(item: shown).includes(:user, occasion: :person).group_by(&:item_id) %>
<% still_wanted, given = shown.partition { !it.given_with?(reservations.fetch(it.id, [])) } %>
<% occasion_choices = yours ? [] : Occasion.for_gifts_to(@person, from: Current.user).upcoming.soonest_first.includes(:person).to_a %>
<% birthday = (t(".birthday", date: l(@person.next_birthday, format: "%-d %B"), countdown: countdown_to(@person.next_birthday).downcase_first) if @person.birthday?) %>

<% sidebar = manages || @person.interests.exists? || @person.sizes.exists? %>
<div class="<%= class_names("page", "page--narrow": !sidebar) %>">
  <%= page_header @person.name, crumbs: [ [ t("layouts.header.home"), root_path ] ], subtitle: birthday,
        avatar: avatar_tag(@person, size: :lg, tooltip: false) do %>
    <% if yours %>
      <%= link_to t(".your_details"), edit_person_profile_path(@person), class: "button button--secondary" %>
    <% else %>
      <%= render "people/chats", person: @person %>
      <% if manages %>
        <%= link_to edit_person_profile_path(@person), class: "icon-button icon-button--outlined group", aria: { label: t(".edit_details") } do %>
          <svg viewBox="0 0 20 20" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 3.5l3 3L7 16H4v-3l9.5-9.5Z"/></svg>
          <span class="tooltip" aria-hidden="true"><%= t(".edit_details") %></span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <div class="<%= class_names("columns": sidebar) %>">
    <section id="list" aria-labelledby="list-heading" class="section min-w-0">
      <%= section_header (yours ? t(".your_list") : t(".their_list", name: @person.name)), id: "list-heading" do %>
        <%= link_to (manages ? t(".add_item") : t(".suggest_item")), new_person_item_path(@person, little: (1 if little_only)), class: "button button--small" %>
      <% end %>

      <nav aria-label="<%= t(".filter") %>" class="tabs mb-4">
        <%= link_to person_path(@person, anchor: "list"), class: "tab", aria: { current: ("page" unless little_only) } do %>
          <%= t(".everything") %> <span class="text-muted"><%= wanted.size %></span>
        <% end %>
        <%= link_to person_path(@person, show: "little", anchor: "list"), class: "tab", aria: { current: ("page" if little_only) } do %>
          <%= t(".little_things") %> <span class="text-muted"><%= wanted.little.size %></span>
        <% end %>
      </nav>

      <% if little_only %>
        <p class="mb-4 text-base text-muted"><%= t(".little_things_intro") %></p>
      <% end %>

      <% if manages %>
        <% passed = Occasion.applying_to(@person).recent.order(date: :desc).first %>
        <% if passed.present? %>
          <p class="notice notice--honey mb-4">
            <% if yours %>
              <%= passed.birthday? ? t(".birthday_passed") : t(".occasion_passed", name: passed.title) %>
            <% else %>
              <%= t(".occasion_passed_for", occasion: passed.title, name: @person.name) %>
            <% end %>
          </p>
        <% end %>
      <% end %>

      <% if shown.any? %>
        <ul class="grid gap-4">
          <% still_wanted.each do |item| %>
            <%= render "items/item", item:, reservations: reservations.fetch(item.id, []), yours:, occasion_choices: %>
          <% end %>
        </ul>

        <% if given.any? %>
          <details class="card card--flush mt-4">
            <summary class="row row--link cursor-pointer list-none font-semibold [&::-webkit-details-marker]:hidden"><%= t(".given", count: given.size) %></summary>
            <ul class="grid gap-4 border-t border-line p-4">
              <% given.each do |item| %>
                <%= render "items/item", item:, reservations: reservations.fetch(item.id, []), yours:, occasion_choices: %>
              <% end %>
            </ul>
          </details>
        <% end %>
      <% elsif little_only %>
        <p class="card empty"><%= manages ? t(".little_empty_yours") : t(".little_empty", name: @person.name) %></p>
      <% elsif yours %>
        <p class="card empty"><%= t(".list_empty_yours") %></p>
      <% elsif manages %>
        <p class="card empty"><%= t(".list_empty_looked_after", name: @person.name) %></p>
      <% else %>
        <p class="card empty"><%= t(".list_empty", name: @person.name) %></p>
      <% end %>
    </section>

    <aside class="min-w-0">
      <%= render "people/interests", person: @person, yours:, manages: %>
      <%= render "people/sizes", person: @person, manages: %>

      <% if manages %>
        <% received = items.received.where(suggested_by: nil) %>
        <% if received.any? %>
          <section aria-labelledby="received-heading" class="section">
            <%= section_header t(".received", count: received.size), id: "received-heading" %>
            <ul class="card card--flush list">
              <% received.each do |item| %>
                <li class="row">
                  <span class="min-w-0 flex-1 text-muted line-through"><%= item.name %></span>
                  <%= button_to t(".put_back"), item_receipt_path(item), method: :delete, class: "button button--secondary button--small" %>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
      <% end %>
    </aside>
  </div>
</div>
