<% content_for :title, t(".title", name: @person.name) %>

<div class="page page--single">
  <%= page_header t(".title", name: @person.name), crumbs: [ [ t("layouts.header.home"), root_path ], [ @person.name, person_path(@person) ] ], subtitle: t(".intro") %>

  <div class="card">
    <ul class="grid list-disc gap-2 pl-5 text-base">
      <% deletion_consequences_for(@person).each do |consequence| %>
        <li><%= consequence %></li>
      <% end %>
    </ul>

    <%= button_to t(".submit", name: @person.name), person_deletion_path(@person), class: "button button--danger button--wide mt-6" %>
  </div>
</div>
