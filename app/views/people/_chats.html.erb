<%# locals: (person:) %>
<% chats = person.memberships.with_chat_visible_to(Current.user).includes(:group).sort_by { it.group.name.downcase } %>

<% if chats.any? %>
  <% unread = Message.unread_by(Current.user).where(subject: chats).group(:subject_id).count %>
  <div class="mb-10 grid gap-3">
    <% chats.each do |membership| %>
      <%= link_to group_membership_messages_path(membership.group, membership, anchor: (unread.key?(membership.id) ? "new" : "latest")),
            data: { turbo_prefetch: false }, class: "card flex items-center gap-3 py-4 no-underline transition-colors hover:border-clay/40 sm:py-4" do %>
        <svg viewBox="0 0 20 20" class="size-5 shrink-0 text-clay" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H9l-4 3v-3H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z"/></svg>
        <span class="min-w-0 flex-1 font-semibold break-words">
          <%= t(".about", name: person.name) %>
          <% if chats.many? %>
            <span class="font-normal text-muted">· <%= membership.group.name %></span>
          <% end %>
        </span>
        <% if unread.key?(membership.id) %>
          <span class="shrink-0 rounded-full bg-clay px-2.5 py-0.5 text-sm font-semibold text-white"><%= t(".new", count: unread[membership.id]) %></span>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
