<%# locals: (person:) %>
<% chats = person.memberships.with_chat_visible_to(Current.user).includes(:group).sort_by { it.group.name.downcase } %>
<% unread = Message.unread_by(Current.user).where(subject: chats).group(:subject_id).count %>

<% chats.each do |membership| %>
  <% count = unread.fetch(membership.id, 0) %>
  <%= link_to group_membership_messages_path(membership.group, membership, anchor: (count.positive? ? "new" : "latest")),
        data: { turbo_prefetch: false }, class: "round-button group",
        aria: { label: t(".label", name: person.name, group: membership.group.name, count:) } do %>
    <svg viewBox="0 0 20 20" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H9l-4 3v-3H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z"/></svg>
    <% if count.positive? %>
      <span class="absolute -top-1 -right-1 inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-clay px-1 text-xs font-semibold text-white ring-2 ring-paper" aria-hidden="true"><%= count %></span>
    <% end %>
    <span class="tooltip" aria-hidden="true"><%= membership.group.name %></span>
  <% end %>
<% end %>
