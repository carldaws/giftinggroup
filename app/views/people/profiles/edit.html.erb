<div class="page page--single">
  <%= page_header (@profile.yours? ? t(".your_details") : t(".their_details", name: @profile.saved_name)), crumbs: [ [ t("layouts.header.home"), root_path ], [ @profile.saved_name, person_path(@profile.person) ] ] %>

  <div class="card">
    <%= form_with model: @profile.person, url: person_profile_path(@profile.person), method: :patch do |form| %>
      <%= render "shared/errors", record: @profile.person %>

      <div class="fields">
        <div class="field">
          <%= form.label :name, t(".name"), class: "label" %>
          <%= form.text_field :name, required: true, autocomplete: (@profile.yours? ? "given-name" : "off"), class: "input" %>
        </div>

        <fieldset class="field">
          <legend class="label mb-2"><%= t(".colour") %></legend>
          <div class="flex flex-wrap gap-3">
            <% User::AVATAR_TONES.each_with_index do |tone, index| %>
              <label class="cursor-pointer rounded-full p-1 ring-2 ring-transparent has-checked:ring-clay has-focus-visible:outline-2 has-focus-visible:outline-clay">
                <%= form.radio_button :avatar_tone, index, checked: @profile.person.avatar_tone_name == tone, class: "sr-only" %>
                <%= avatar_tag @profile.person, tone:, tooltip: false, ring: false %>
                <span class="sr-only"><%= t(".tones.#{tone}") %></span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <fieldset class="field">
          <legend class="label mb-2"><%= t(".picture") %></legend>
          <div class="flex flex-wrap gap-3">
            <% [ nil, *User::AVATAR_CHARACTERS ].each do |character| %>
              <label class="group relative cursor-pointer rounded-full p-1 ring-2 ring-transparent has-checked:ring-clay has-focus-visible:outline-2 has-focus-visible:outline-clay">
                <%= form.radio_button :avatar_character, character.to_s, checked: @profile.person.avatar_character_name == character, class: "sr-only" %>
                <%= avatar_tag @profile.person, character:, tooltip: false, ring: false %>
                <span class="tooltip"><%= character.present? ? t(".characters.#{character}") : t(".initials") %></span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <fieldset class="field" aria-describedby="birthday-hint">
          <legend class="label mb-2"><%= t(".birthday") %></legend>
          <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-2 sm:grid-cols-[6.5rem_minmax(0,1fr)_6rem]">
            <%= form.label :birthday_day, t(".day"), class: "sr-only" %>
            <%= form.select :birthday_day, 1..31, { include_blank: t(".day") }, class: "input select" %>
            <%= form.label :birthday_month, t(".month"), class: "sr-only" %>
            <%= form.select :birthday_month, (1..12).map { [ l(Date.new(2000, it, 1), format: "%B"), it ] }, { include_blank: t(".month") }, class: "input select" %>
            <%= form.label :birth_year, t(".year"), class: "sr-only" %>
            <%= form.number_field :birth_year, placeholder: t(".year"), min: 1900, max: Date.current.year, inputmode: "numeric", class: "input" %>
          </div>
          <p id="birthday-hint" class="hint"><%= @profile.yours? ? t(".birthday_hint_yours") : t(".birthday_hint", name: @profile.saved_name) %></p>
        </fieldset>

        <% if @profile.yours? %>
          <div class="field">
            <%= form.label :email_address, t(".email_address"), class: "label" %>
            <%= form.email_field :email_address, required: true, autocomplete: "username", class: "input" %>
          </div>

          <div class="field">
            <%= form.label :password_challenge, t(".password_challenge"), class: "label" %>
            <%= form.password_field :password_challenge, autocomplete: "current-password", class: "input", aria: { describedby: "password-challenge-hint" } %>
            <p id="password-challenge-hint" class="hint"><%= t(".password_challenge_hint") %></p>
          </div>
        <% end %>
      </div>

      <div class="form-actions">
        <%= form.submit t(".submit"), class: "button button--wide" %>
      </div>
    <% end %>

    <% if @profile.yours? %>
      <div class="mt-6 border-t border-line pt-6">
        <%= link_to t(".delete_account"), new_account_deletion_path, class: "button button--danger button--wide" %>
      </div>
    <% end %>
  </div>

  <% unless @profile.yours? %>
    <section id="guardians" aria-labelledby="guardians-heading" class="section mt-10">
      <%= section_header t(".guardians_heading", name: @profile.saved_name), id: "guardians-heading" %>

      <ul class="card card--flush list">
        <% @profile.guardianships.each do |guardianship| %>
          <li class="row">
            <%= avatar_tag guardianship.guardian, size: :sm, tooltip: false %>
            <span class="row-title min-w-0 flex-1"><%= @profile.you?(guardianship) ? t(".you") : guardianship.guardian.name %></span>
            <% if @profile.several_guardians? %>
              <%= button_to (@profile.you?(guardianship) ? t(".stop_looking_after") : t(".remove_guardian")), person_guardianship_path(@profile.person, guardianship), method: :delete,
                    class: "button button--secondary button--small",
                    form: { data: { turbo_confirm: (@profile.you?(guardianship) ? t(".stop_confirm", name: @profile.saved_name) : t(".remove_confirm", guardian: guardianship.guardian.name, name: @profile.saved_name)) } } %>
            <% end %>
          </li>
        <% end %>

        <% if @profile.possible_guardians.any? %>
          <li class="row">
            <%= form_with model: Guardianship.new, url: person_guardianships_path(@profile.person), class: "flex w-full flex-wrap gap-2" do |form| %>
              <%= form.label :guardian_id, t(".add_guardian_label", name: @profile.saved_name), class: "sr-only" %>
              <%= form.collection_select :guardian_id, @profile.possible_guardians, :id, :name, { prompt: t(".add_guardian_prompt") },
                    required: true, class: "input select min-w-0 flex-1" %>
              <%= form.submit t(".add_guardian"), class: "button button--secondary" %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <p class="hint mt-3"><%= t(".guardians_hint", name: @profile.saved_name) %></p>
    </section>

    <%= link_to t(".delete_person", name: @profile.saved_name), new_person_deletion_path(@profile.person), class: "button button--danger button--wide" %>
  <% end %>
</div>
