<%# locals: (person:, yours:, manages:) %>
<% if manages || person.interests.any? %>
  <section id="things-i-love" aria-labelledby="interests-heading" class="section">
    <%= section_header (yours ? t(".heading_yours") : t(".heading", name: person.name)), id: "interests-heading" %>

    <div class="card">
      <% if person.interests.any? %>
        <ul class="flex flex-wrap gap-2">
          <% person.interests.order(:created_at).each do |interest| %>
            <li class="tag">
              <%= interest.name %>
              <% if manages %>
                <%= button_to person_interest_path(person, interest), method: :delete, class: "icon-button icon-button--small",
                      aria: { label: t(".remove", name: interest.name) } do %>
                  <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15"/></svg>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>

      <% if manages %>
        <%= form_with model: Interest.new, url: person_interests_path(person), class: class_names("flex gap-2", "mt-4": person.interests.any?) do |form| %>
          <%= form.label :name, t(".add_label"), class: "sr-only" %>
          <%= form.text_field :name, required: true, placeholder: t(".placeholder"), class: "input" %>
          <%= form.submit t(".add"), class: "button button--secondary" %>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
