<% content_for :title, t(".title") %>

<div class="mt-6 text-center">
  <% if @group.nil? %>
    <h1 class="mb-3 text-4xl font-semibold"><%= t(".not_found_heading") %></h1>
    <p class="mb-8 text-muted"><%= t(".not_found") %></p>
    <% if authenticated? %>
      <%= link_to t(".try_code"), new_join_path, class: "button w-full" %>
    <% end %>
  <% else %>
    <div class="mb-6 flex justify-center -space-x-3">
      <% @group.members.first(5).each do |member| %>
        <%= avatar_tag member, size: "size-14 text-lg" %>
      <% end %>
    </div>

    <p class="text-muted"><%= t(".invited") %></p>
    <h1 class="mb-2 text-4xl font-semibold break-words"><%= @group.name %></h1>
    <p class="mb-8 text-muted"><%= t(".people", count: @group.members.size) %></p>

    <% if !authenticated? %>
      <div class="grid gap-3">
        <%= link_to t(".create_account"), new_registration_path, class: "button" %>
        <%= link_to t(".sign_in"), new_session_path, class: "button button--quiet" %>
      </div>
    <% elsif @group.members.include?(Current.user) %>
      <p class="mb-4"><%= t(".already_member") %></p>
      <%= link_to t(".open_group"), @group, class: "button w-full" %>
    <% else %>
      <%= button_to t(".join", group: @group.name), joins_path, params: { join_code: @group.join_code }, class: "button w-full" %>
    <% end %>
  <% end %>
</div>
