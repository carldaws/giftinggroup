<% content_for :title, t(".title") %>
<% saved_photos = @item.photos_attachments.includes(:blob).order(:id) %>

<div class="page page--single">
  <%= page_header @item.saved_title, crumb: @item.saved_title, crumbs: [ [ t("layouts.header.home"), root_path ], [ @item.owner.name, person_path(@item.owner) ] ] %>

  <div class="card">
    <% if saved_photos.any? %>
      <div class="mb-6">
        <h2 class="label mb-2"><%= t(".photos") %></h2>
        <ul class="flex flex-wrap gap-3">
          <% saved_photos.each do |photo| %>
            <li class="relative">
              <%= image_tag photo.variant(:thumb), alt: "", class: "size-20 rounded-xl object-cover" %>
              <%= button_to item_photo_path(@item, photo), method: :delete, form_class: "absolute -top-2 -right-2",
                    class: "icon-button icon-button--outlined icon-button--small shadow-sm hover:text-danger",
                    aria: { label: t(".remove_photo") }, form: { data: { turbo_confirm: t(".remove_photo_confirm") } } do %>
                <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15"/></svg>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= render "items/form", item: @item, url: item_path(@item), submit: t(".submit") %>

    <div class="mt-6 border-t border-line pt-6">
      <%= button_to t(".remove"), item_path(@item), method: :delete, class: "button button--danger button--wide",
            form: { data: { turbo_confirm: t(".remove_confirm", name: @item.title) } } %>
    </div>
  </div>
</div>
