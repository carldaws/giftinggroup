<%# locals: (card:) %>
<li id="<%= dom_id(card.item) %>" class="card card--flush">
  <div class="flex gap-4 p-5 sm:p-6">
    <% if card.main_photo.present? %>
      <%= link_to url_for(card.main_photo.variant(:large)), target: "_blank", class: "shrink-0" do %>
        <%= image_tag card.main_photo.variant(:thumb), alt: "", class: "size-20 rounded-xl object-cover sm:size-24" %>
      <% end %>
    <% end %>

    <div class="min-w-0 flex-1">
      <% if card.badges? %>
        <div class="mb-2 flex flex-wrap gap-1.5">
          <% if card.item.most_wanted? %><span class="badge badge--honey"><%= t(".most_wanted") %></span><% end %>
          <% if card.item.little? %><span class="badge badge--sage"><%= t(".little") %></span><% end %>
          <% if card.item.suggestion? %>
            <span class="badge badge--plum"><%= t(".idea_from", name: names_of([ card.item.suggested_by ])) %></span>
          <% end %>
        </div>
      <% end %>

      <h3 class="text-lg leading-snug font-semibold break-words"><%= card.item.title %></h3>

      <%= item_details_tag(card.item) %>

      <% if card.item.notes.present? %>
        <p class="mt-3 whitespace-pre-line break-words"><%= card.item.notes %></p>
      <% end %>

      <% if card.item.url.present? %>
        <%= link_to card.item.url, target: "_blank", rel: "noopener noreferrer", class: "link mt-3 inline-flex items-center gap-1.5 text-base" do %>
          <%= t(".view_link", host: card.item.shop) %>
          <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 4H4v12h12v-4M11 3h6v6M17 3l-8 8"/></svg>
        <% end %>
      <% end %>

      <% if card.extra_photos.any? %>
        <div class="mt-3 flex flex-wrap gap-2">
          <% card.extra_photos.each do |photo| %>
            <%= link_to url_for(photo.variant(:large)), target: "_blank" do %>
              <%= image_tag photo.variant(:thumb), alt: "", class: "size-14 rounded-xl object-cover" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <% if card.actions? %>
    <div class="card-footer grid gap-3">
      <% if card.reservations_shown? %>
        <% if card.reservations.any? %>
          <ul class="flex flex-wrap gap-2">
            <% card.reservations.each do |reservation| %>
              <li class="chip">
                <% reservation.people.each do |person| %>
                  <%= avatar_tag person, size: :sm, tooltip: false, ring: false %>
                <% end %>
                <%= status_for(reservation, with_occasion: card.occasion_shown_for?(reservation)) %>
              </li>
            <% end %>
          </ul>
        <% end %>

        <% if card.item.released_by_name.present? %>
          <p class="text-base font-medium text-honey-ink"><%= t(".released", name: card.item.released_by_name) %></p>
        <% end %>

        <% if card.choosing_occasion? %>
          <%= form_with model: card.my_reservation, url: item_reservation_path(card.item), method: :patch, data: { controller: "autosubmit" }, class: "flex flex-wrap items-center gap-3" do |form| %>
            <%= form.label :occasion_id, t(".for"), class: "text-base text-muted" %>
            <%= form.collection_select :occasion_id, card.occasion_choices, :id, :title, { include_blank: t(".no_occasion") },
                  class: "input select w-auto text-base", data: { action: "change->autosubmit#submit" } %>
            <noscript><%= form.submit t(".save_occasion"), class: "button button--secondary button--small" %></noscript>
          <% end %>
        <% end %>
      <% end %>

      <div class="flex flex-wrap gap-2">
        <% if card.reservations_shown? %>
          <% if card.joined_split.present? %>
            <% unless card.joined_split.bought? %>
              <%= button_to t(".leave_split"), item_split_share_path(card.item, card.joined_split), method: :delete, class: "button button--secondary button--small" %>
            <% end %>
          <% elsif card.my_reservation.nil? %>
            <% card.joinable_splits.each do |split| %>
              <%= button_to t(".join_split", name: split.user.name), item_split_share_path(card.item, split), class: "button button--small" %>
            <% end %>
            <% if card.reservable? %>
              <%= button_to t(".reserve"), item_reservation_path(card.item), class: "button button--small" %>
              <% if card.splittable? %>
                <details class="group/split">
                  <summary class="button button--secondary button--small list-none group-open/split:hidden [&::-webkit-details-marker]:hidden"><%= t(".split") %></summary>
                  <%= form_with url: item_reservation_path(card.item), scope: :reservation, class: "flex flex-wrap items-center gap-2" do |form| %>
                    <%= form.label :split_with, t(".split_with"), class: "text-base font-semibold" %>
                    <%= form.select :split_with, split_options_for(card), {}, class: "input select h-9 w-auto text-base" %>
                    <%= form.submit t(".start_split"), class: "button button--small" %>
                  <% end %>
                </details>
              <% end %>
            <% end %>
          <% elsif card.my_reservation.bought? %>
            <% unless card.my_reservation.given? %>
              <%= button_to t(".not_bought"), item_purchase_path(card.item), method: :delete, class: "button button--secondary button--small" %>
            <% end %>
          <% elsif card.my_reservation.waiting? %>
            <%= button_to t(".call_off_split"), item_reservation_path(card.item), method: :delete, class: "button button--secondary button--small" %>
          <% else %>
            <%= button_to t(".bought_it"), item_purchase_path(card.item), class: "button button--small" %>
            <%= button_to t(".let_go"), item_reservation_path(card.item), method: :delete, class: "button button--secondary button--small" %>
          <% end %>
        <% end %>

        <% if card.receivable? %>
          <%= button_to item_receipt_path(card.item), class: "button button--secondary button--small" do %>
            <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l4 4 8-9"/></svg>
            <%= t(".got_it") %>
          <% end %>
        <% end %>

        <% if card.editable? %>
          <%= link_to edit_item_path(card.item), class: "button button--secondary button--small" do %>
            <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 3.5l3 3L7 16H4v-3z"/></svg>
            <%= t(".edit") %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</li>
