<%# locals: (item:, reservations:, surprises_hidden:, occasion_choices:) %>
<% mine = reservations.find { it.user == Current.user } %>
<% others = reservations - [ mine ] %>
<% picking_occasion = mine.present? && !mine.given? && occasion_choices.any? %>
<% editable = item.editable_by?(Current.user) %>
<% receivable = item.receivable_by?(Current.user) %>
<% extra_photos = item.photos.drop(1) %>

<li id="<%= dom_id(item) %>" class="card card--flush">
  <div class="flex gap-4 p-5 sm:p-6">
    <% if item.photos.attached? %>
      <%= link_to url_for(item.photos.first.variant(:large)), target: "_blank", class: "shrink-0" do %>
        <%= image_tag item.photos.first.variant(:thumb), alt: "", class: "size-20 rounded-xl object-cover sm:size-24" %>
      <% end %>
    <% end %>

    <div class="min-w-0 flex-1">
      <% if item.most_wanted? || item.little? || item.suggestion? %>
        <div class="mb-2 flex flex-wrap gap-1.5">
          <% if item.most_wanted? %><span class="badge badge--honey"><%= t(".most_wanted") %></span><% end %>
          <% if item.little? %><span class="badge badge--sage"><%= t(".little") %></span><% end %>
          <% if item.suggestion? %>
            <span class="badge badge--plum"><%= t(".idea_from", name: item.suggested_by == Current.user ? t(".you") : item.suggested_by.name) %></span>
          <% end %>
        </div>
      <% end %>

      <h3 class="text-lg leading-snug font-semibold break-words"><%= item.title %></h3>

      <% details = [ item.price.presence, (item.unlimited? ? t(".as_many_as_you_like") : (t(".wants", count: item.quantity) if item.quantity > 1)) ].compact %>
      <% if details.any? %>
        <p class="row-meta mt-0.5"><%= details.join(" · ") %></p>
      <% end %>

      <% if item.notes.present? %>
        <p class="mt-3 whitespace-pre-line break-words"><%= item.notes %></p>
      <% end %>

      <% if item.url.present? %>
        <%= link_to item.url, target: "_blank", rel: "noopener noreferrer", class: "link mt-3 inline-flex items-center gap-1.5 text-base" do %>
          <%= t(".view_link", host: item.shop) %>
          <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 4H4v12h12v-4M11 3h6v6M17 3l-8 8"/></svg>
        <% end %>
      <% end %>

      <% if extra_photos.any? %>
        <div class="mt-3 flex flex-wrap gap-2">
          <% extra_photos.each do |photo| %>
            <%= link_to url_for(photo.variant(:large)), target: "_blank" do %>
              <%= image_tag photo.variant(:thumb), alt: "", class: "size-14 rounded-xl object-cover" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <% if !surprises_hidden || editable || receivable %>
    <div class="card-footer grid gap-3">
      <% unless surprises_hidden %>
        <% if reservations.any? %>
          <ul class="flex flex-wrap gap-2">
            <% reservations.each do |reservation| %>
              <li class="chip">
                <%= avatar_tag reservation.user, size: :sm, tooltip: false, ring: false %>
                <%= status_for(reservation, with_occasion: !(picking_occasion && reservation == mine)) %>
              </li>
            <% end %>
          </ul>
        <% end %>

        <% if item.released_by_name.present? %>
          <p class="text-base font-medium text-honey-ink"><%= t(".released", name: item.released_by_name) %></p>
        <% end %>

        <% if picking_occasion %>
          <%= form_with model: mine, url: item_reservation_path(item), method: :patch, data: { controller: "autosubmit" }, class: "flex flex-wrap items-center gap-3" do |form| %>
            <%= form.label :occasion_id, t(".for"), class: "text-base text-muted" %>
            <%= form.select :occasion_id, occasion_choices.map { [ it.title, it.id ] }, { include_blank: t(".no_occasion") },
                  class: "input select w-auto text-base", data: { action: "change->autosubmit#submit" } %>
            <noscript><%= form.submit t(".save_occasion"), class: "button button--secondary button--small" %></noscript>
          <% end %>
        <% end %>
      <% end %>

      <div class="flex flex-wrap gap-2">
        <% unless surprises_hidden %>
          <% if mine.nil? %>
            <% if item.unlimited? || others.size < item.quantity %>
              <%= button_to t(".reserve"), item_reservation_path(item), class: "button button--small" %>
            <% end %>
          <% elsif mine.bought? %>
            <% unless mine.given? %>
              <%= button_to t(".not_bought"), item_purchase_path(item), method: :delete, class: "button button--secondary button--small" %>
            <% end %>
          <% else %>
            <%= button_to t(".bought_it"), item_purchase_path(item), class: "button button--small" %>
            <%= button_to t(".let_go"), item_reservation_path(item), method: :delete, class: "button button--secondary button--small" %>
          <% end %>
        <% end %>

        <% if receivable %>
          <%= button_to item_receipt_path(item), class: "button button--secondary button--small" do %>
            <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l4 4 8-9"/></svg>
            <%= t(".got_it") %>
          <% end %>
        <% end %>

        <% if editable %>
          <%= link_to edit_item_path(item), class: "button button--secondary button--small" do %>
            <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 3.5l3 3L7 16H4v-3z"/></svg>
            <%= t(".edit") %>
          <% end %>
        <% end %>
      </div>

      <% if item.suggestion? && !surprises_hidden %>
        <%= render "items/comments", item: %>
      <% end %>
    </div>
  <% end %>
</li>
