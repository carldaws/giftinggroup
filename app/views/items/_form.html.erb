<%# locals: (item:, url:, submit:) %>
<%= form_with model: item, url:, data: { controller: "clear-files link-preview", action: "turbo:submit-end->clear-files#clear", link_preview_endpoint_value: link_preview_path } do |form| %>
  <%= render "shared/errors", record: item %>

  <div class="fields">
    <div class="field">
      <%= form.label :name, t("items.form.name"), class: "label" %>
      <%= form.text_field :name, autofocus: item.new_record?, class: "input", data: { link_preview_target: "name" } %>
    </div>

    <div class="field">
      <%= form.label :url, t("items.form.url"), class: "label" %>
      <%= form.url_field :url, placeholder: "https://", inputmode: "url", class: "input", aria: { describedby: "item-url-hint" },
            data: { link_preview_target: "url", action: "input->link-preview#typed change->link-preview#look" } %>
      <p id="item-url-hint" class="hint"><%= t("items.form.url_hint") %></p>
      <p class="hint" role="status" hidden data-link-preview-target="status"><%= t("items.form.looking") %></p>
      <div class="mt-3 flex items-center gap-4" hidden data-link-preview-target="preview">
        <img alt="" class="size-20 rounded-xl object-cover" data-link-preview-target="image">
        <label class="choice">
          <input type="checkbox" name="item[photos][]" class="checkbox" disabled data-link-preview-target="photo">
          <span class="font-semibold"><%= t("items.form.use_photo") %></span>
        </label>
      </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      <div class="field content-start">
        <%= form.label :price, t("items.form.price"), class: "label" %>
        <%= form.text_field :price, placeholder: t("items.form.price_placeholder"), class: "input" %>
      </div>
      <div class="field content-start">
        <%= form.label :quantity, t("items.form.quantity"), class: "label" %>
        <%= form.number_field :quantity, min: 1, inputmode: "numeric", class: "input", aria: { describedby: "item-quantity-hint" } %>
        <p id="item-quantity-hint" class="hint"><%= t("items.form.quantity_hint") %></p>
      </div>
    </div>

    <div class="field">
      <%= form.label :notes, t("items.form.notes"), class: "label" %>
      <%= form.text_area :notes, rows: 3, placeholder: t("items.form.notes_placeholder"), class: "input" %>
    </div>

    <div class="field">
      <%= form.label :photos, (item.photos_attachments.any?(&:persisted?) ? t("items.form.more_photos") : t("items.form.photos")), class: "label" %>
      <%= form.file_field :photos, multiple: true, include_hidden: false, class: "input", aria: { describedby: "item-photos-hint" }, data: { clear_files_target: "input" } %>
      <p id="item-photos-hint" class="hint"><%= t("items.form.photos_hint", count: Item::PHOTO_MAX_COUNT) %></p>
    </div>

    <div class="grid gap-4">
      <% if item.surprise_choosable_by?(Current.user) %>
        <label class="choice">
          <%= form.check_box :asked_for, class: "checkbox" %>
          <span>
            <span class="block font-semibold"><%= t("items.form.asked_for", name: item.owner.name) %></span>
            <span class="hint block"><%= t("items.form.asked_for_hint", name: item.owner.name) %></span>
          </span>
        </label>
      <% end %>
      <label class="choice">
        <%= form.check_box :most_wanted, class: "checkbox" %>
        <span>
          <span class="block font-semibold"><%= t("items.form.most_wanted") %></span>
          <span class="hint block"><%= t("items.form.most_wanted_hint") %></span>
        </span>
      </label>
      <label class="choice">
        <%= form.check_box :little, class: "checkbox" %>
        <span>
          <span class="block font-semibold"><%= t("items.form.little") %></span>
          <span class="hint block"><%= t("items.form.little_hint") %></span>
        </span>
      </label>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit submit, class: "button button--wide" %>
  </div>
<% end %>
