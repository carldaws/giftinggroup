<%# locals: (occasion:, url:, submit:) %>
<%= form_with model: occasion, url: do |form| %>
  <%= render "shared/errors", record: occasion %>

  <div class="fields">
    <div class="field">
      <%= form.label :name, t("groups.occasions.form.name"), class: "label" %>
      <%= form.text_field :name, required: true, autofocus: occasion.new_record?, placeholder: t("groups.occasions.form.name_placeholder"), class: "input" %>
    </div>

    <div class="field">
      <%= form.label :date, t("groups.occasions.form.date"), class: "label" %>
      <%= form.date_field :date, required: true, class: "input" %>
    </div>

    <fieldset class="field" data-controller="checkboxes"
              data-checkboxes-select-all-value="<%= t("groups.occasions.form.select_all") %>"
              data-checkboxes-clear-all-value="<%= t("groups.occasions.form.clear_all") %>">
      <legend class="label mb-2"><%= t("groups.occasions.form.people") %></legend>
      <p class="hint"><%= t("groups.occasions.form.people_hint") %></p>
      <div>
        <button type="button" class="button button--secondary button--small" data-checkboxes-target="toggle" data-action="checkboxes#toggleAll">
          <%= t("groups.occasions.form.clear_all") %>
        </button>
      </div>

      <%= hidden_field_tag "occasion[member_ids][]", "" %>
      <div class="flex flex-wrap gap-2">
        <% occasion.group.members_by_name.each do |member| %>
          <label class="chip chip--toggle">
            <%= check_box_tag "occasion[member_ids][]", member.id, occasion.chosen_member?(member),
                  id: "occasion_member_#{member.id}", class: "sr-only",
                  data: { checkboxes_target: "checkbox", action: "checkboxes#update" } %>
            <%= avatar_tag member, size: :sm, tooltip: false, ring: false %>
            <%= member.name %>
          </label>
        <% end %>
      </div>
    </fieldset>
  </div>

  <div class="form-actions">
    <%= form.submit submit, class: "button button--wide" %>
  </div>
<% end %>
