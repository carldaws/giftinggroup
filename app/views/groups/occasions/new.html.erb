<% content_for :title, t(".title") %>

<div class="page page--single">
  <%= page_header t(".heading"), crumbs: [ [ t("layouts.header.home"), root_path ], [ @group.name, @group ] ], subtitle: t(".intro") %>

  <div class="card">
    <%= render "groups/occasions/form", occasion: @occasion, url: group_occasions_path(@group), submit: t(".submit") %>
  </div>
</div>
