<%# locals: (dashboard:) %>
<% if dashboard.splits.any? %>
  <section id="splits" aria-labelledby="splits-heading" class="section">
    <%= section_header t(".heading"), id: "splits-heading" %>

    <ul class="card card--flush list">
      <% dashboard.splits.each do |split| %>
        <li class="row">
          <%= avatar_tag split.item.owner %>
          <div class="min-w-0 flex-1">
            <%= item_title_link(split.item) %>
            <p class="row-meta"><%= t(".for", name: split.item.owner.name) %></p>
            <p class="row-meta"><%= status_for(split) %></p>
            <%= split_note_tag(split) %>
          </div>
          <% if split.started_by?(Current.user) %>
            <%= button_to t(".call_off"), item_reservation_path(split.item), method: :delete, class: "button button--secondary button--small" %>
          <% elsif split.joined_by?(Current.user) %>
            <%= button_to t(".leave"), item_split_share_path(split.item, split), method: :delete, class: "button button--secondary button--small" %>
          <% elsif split.joinable_by?(Current.user) %>
            <%= button_to t(".join"), item_split_share_path(split.item, split), class: "button button--small" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
