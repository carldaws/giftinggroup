<% admin = @group.admin?(Current.user) %>
<% memberships = @group.memberships.by_name.includes(user: :guardians) %>

<div class="page">
  <%= page_header @group.name, crumbs: [ [ t("layouts.header.home"), root_path ] ], subtitle: t(".people", count: memberships.size) do %>
    <%= link_to t(".rename"), edit_group_path(@group), class: "button button--secondary" %>
  <% end %>

  <div class="columns">
    <div class="min-w-0">
      <%= render "groups/coming_up", group: @group %>

      <section aria-labelledby="people-heading" class="section">
        <%= section_header t(".people_heading"), id: "people-heading" %>

        <ul class="card card--flush list">
          <% memberships.each do |membership| %>
            <%= render "groups/membership", membership:, admin: %>
          <% end %>
          <li>
            <%= link_to new_group_dependant_path(@group), class: "row row--link" do %>
              <%= render "shared/add_icon" %>
              <span class="min-w-0">
                <span class="row-title block text-clay"><%= t(".add_dependant") %></span>
                <span class="row-meta block"><%= t(".add_dependant_hint") %></span>
              </span>
            <% end %>
          </li>
        </ul>
      </section>
    </div>

    <aside class="min-w-0">
      <section aria-labelledby="invite-heading" class="section">
        <%= section_header t(".invite_heading"), id: "invite-heading" %>

        <div class="card">
          <p class="text-base text-muted"><%= t(".invite_intro") %></p>

          <% invite_url = join_url(@group.join_code) %>
          <div class="mt-4" data-controller="share" data-share-url-value="<%= invite_url %>"
               data-share-title-value="<%= t(".share_title", group: @group.name) %>" data-share-copied-value="<%= t(".copied") %>">
            <p class="inset font-mono text-sm break-all"><%= invite_url %></p>
            <div class="mt-3 grid gap-2">
              <button type="button" class="button" hidden data-share-target="shareButton" data-action="share#share"><%= t(".share") %></button>
              <button type="button" class="button button--secondary" data-share-target="copyButton" data-action="share#copy"><%= t(".copy") %></button>
            </div>
          </div>

          <p class="mt-4 text-base text-muted">
            <%= t(".or_code_html", code: tag.strong(@group.formatted_join_code, class: "font-mono font-semibold tracking-wider text-ink")) %>
          </p>

          <% if admin %>
            <%= button_to t(".new_code"), group_join_code_path(@group), method: :patch,
                  class: "link mt-3 cursor-pointer text-base", form: { data: { turbo_confirm: t(".new_code_confirm") } } %>
          <% end %>
        </div>
      </section>
    </aside>
  </div>
</div>
