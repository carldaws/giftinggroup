<% content_for :title, t(".title") %>

<div class="page page--single">
  <%= page_header t(".heading"), crumbs: [ [ t("layouts.header.home"), root_path ], [ @group.name, @group ] ], subtitle: t(".intro") %>

  <div class="card">
    <%= form_with model: @dependant, url: group_dependants_path(@group) do |form| %>
      <%= render "shared/errors", record: @dependant %>

      <div class="field">
        <%= form.label :name, t(".name"), class: "label" %>
        <%= form.text_field :name, required: true, autofocus: true, class: "input", aria: { describedby: "dependant-name-hint" } %>
        <p id="dependant-name-hint" class="hint"><%= t(".hint") %></p>
      </div>

      <div class="form-actions">
        <%= form.submit t(".submit"), class: "button button--wide" %>
      </div>
    <% end %>
  </div>
</div>
