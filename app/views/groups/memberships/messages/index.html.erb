<% person = @membership.user %>
<% content_for :title, t(".title", name: person.name) %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= turbo_stream_from @membership %>

<div class="page page--single">
  <%= page_header t(".heading", name: person.name), subtitle: render("messages/readers", group: @group, readers: @membership.chat_readers.to_a),
        avatar: avatar_tag(person, tooltip: false),
        crumbs: [ [ t("layouts.header.home"), root_path ], [ @group.name, @group ], [ person.name, person_path(person) ] ] %>

  <%= render "messages/chat", messages: @membership.messages_about.includes(:author).chronologically,
        first_unread: @membership.messages_about.unread_by(Current.user).chronologically.first,
        message: @message, url: group_membership_messages_path(@group, @membership), label: t(".label", name: person.name) %>
</div>
