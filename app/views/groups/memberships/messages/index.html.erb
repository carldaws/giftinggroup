<% person = @membership.user %>
<% messages = @membership.messages_about.includes(:author).chronologically %>
<% first_unread = @membership.messages_about.unread_by(Current.user).chronologically.first %>
<% readers = @membership.chat_readers.to_a %>
<% content_for :title, t(".title", name: person.name) %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<%= turbo_stream_from @membership %>

<div class="page page--narrow">
  <% subtitle = capture do %>
    <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <span><%= @group.name %></span>
      <span class="flex gap-1" role="img" aria-label="<%= t(".readers", names: readers.map(&:name).to_sentence) %>">
        <% readers.first(8).each do |reader| %>
          <%= avatar_tag reader, size: :xs %>
        <% end %>
        <% if readers.size > 8 %>
          <span class="inline-flex size-6 items-center justify-center rounded-full bg-line text-[0.625rem] font-semibold text-ink ring-2 ring-surface">+<%= readers.size - 8 %></span>
        <% end %>
      </span>
    </span>
  <% end %>

  <%= page_header t(".heading", name: person.name), subtitle:, avatar: avatar_tag(person, tooltip: false),
        crumbs: [ [ t("layouts.header.home"), root_path ], [ @group.name, @group ], [ person.name, person_path(person) ] ] %>

  <div class="card card--flush">
    <div class="px-5 py-5 sm:p-6">
      <% if messages.any? %>
        <ol class="grid gap-3">
          <% messages.each do |message| %>
            <% if message == first_unread %>
              <li id="new" class="flex scroll-mt-24 items-center gap-3 text-sm font-semibold text-clay">
                <span class="h-px flex-1 bg-clay/30"></span>
                <%= t(".new") %>
                <span class="h-px flex-1 bg-clay/30"></span>
              </li>
            <% end %>
            <%= render "messages/message", message: %>
          <% end %>
        </ol>
      <% else %>
        <p class="empty py-6 text-center"><%= t(".empty") %></p>
      <% end %>
    </div>

    <div id="latest" class="card-footer sticky bottom-0 bg-card pb-[max(1rem,env(safe-area-inset-bottom))]">
      <%= render "shared/errors", record: @message %>

      <%= form_with model: @message, url: group_membership_messages_path(@group, @membership), class: "flex items-center gap-2",
            data: { controller: "reset-form", action: "turbo:submit-end->reset-form#reset" } do |form| %>
        <%= form.label :body, t(".label", name: person.name), class: "sr-only" %>
        <%= form.text_field :body, required: true, maxlength: 2000, autocomplete: "off", placeholder: t(".placeholder"),
              class: "input", data: { turbo_permanent: true } %>
        <%= form.submit t(".send"), class: "button" %>
      <% end %>
    </div>
  </div>
</div>
