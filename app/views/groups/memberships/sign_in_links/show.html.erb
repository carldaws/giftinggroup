<% content_for :title, t(".title") %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<% person = @membership.user %>

<div class="mt-6">
  <%= link_to t(".back", group: @group.name), @group, class: "text-muted underline" %>

  <h1 class="mt-4 mb-3 text-4xl font-semibold"><%= t(".heading", name: person.name) %></h1>
  <p class="mb-8 text-muted">
    <%= @membership.dependant? ? t(".set_up_intro", name: person.name) : t(".reset_intro", name: person.name) %>
  </p>

  <div class="card" data-controller="share" data-share-url-value="<%= @sign_in_link %>"
       data-share-title-value="<%= t(".share_title") %>" data-share-copied-value="<%= t(".copied") %>">
    <div class="grid gap-3">
      <button type="button" class="button" hidden data-share-target="shareButton" data-action="share#share"><%= t(".share") %></button>
      <button type="button" class="button button--quiet" data-share-target="copyButton" data-action="share#copy"><%= t(".copy") %></button>
    </div>
    <p class="hint mt-5"><%= @membership.dependant? ? t(".set_up_expiry") : t(".reset_expiry", name: person.name) %></p>
  </div>
</div>
