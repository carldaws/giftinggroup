<% content_for :title, t(".title") %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<% person = @membership.user %>

<div class="page page--narrow">
  <%= page_header t(".heading", name: person.name), crumbs: [ [ t("layouts.header.home"), root_path ], [ @group.name, @group ] ],
        subtitle: (@membership.dependant? ? t(".set_up_intro", name: person.name) : t(".reset_intro", name: person.name)) %>

  <div class="card" data-controller="share" data-share-url-value="<%= @sign_in_link %>"
       data-share-title-value="<%= t(".share_title") %>" data-share-copied-value="<%= t(".copied") %>">
    <div class="flex flex-col gap-3 sm:flex-row">
      <button type="button" class="button button--wide" hidden data-share-target="shareButton" data-action="share#share"><%= t(".share") %></button>
      <button type="button" class="button button--secondary button--wide" data-share-target="copyButton" data-action="share#copy"><%= t(".copy") %></button>
    </div>
    <p class="hint mt-5"><%= @membership.dependant? ? t(".set_up_expiry") : t(".reset_expiry", name: person.name) %></p>
  </div>
</div>
