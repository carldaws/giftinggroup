<% content_for :title, t(".title") %>

<div class="page page--single">
  <%= page_header t(".heading", name: Current.user.first_name), crumb: t("layouts.header.home") %>

  <%= render "groups/your_lists", lists: Current.user.lists %>
  <%= render "messages/unread", chats: Current.user.unread_chats %>
  <%= render "occasions/gifts_to_choose", choices: Current.user.gifts_to_choose %>
  <%= render "groups/splits", splits: Current.user.splits_waiting %>
  <%= render "groups/shopping_list", shopping_list: Current.user.shopping_list %>

  <section aria-labelledby="groups-heading" class="section">
    <%= section_header t(".groups_heading"), id: "groups-heading" %>

    <ul class="card card--flush list">
      <% if @groups.none? %>
        <li class="row">
          <div>
            <p class="row-title"><%= t(".empty_heading") %></p>
            <p class="row-meta"><%= t(".empty") %></p>
          </div>
        </li>
      <% end %>
      <% @groups.each do |group| %>
        <li>
          <%= link_to group, class: "row row--link" do %>
            <div class="min-w-0 flex-1">
              <p class="row-title"><%= group.name %></p>
              <p class="row-meta"><%= t(".people", count: group.members.size) %></p>
            </div>
            <div class="avatar-stack">
              <% group.members.first(4).each do |member| %>
                <%= avatar_tag member, size: :sm %>
              <% end %>
            </div>
          <% end %>
        </li>
      <% end %>
      <li>
        <%= link_to new_group_path, class: "row row--link font-semibold text-clay" do %>
          <%= render "shared/add_icon" %>
          <%= t(".start") %>
        <% end %>
      </li>
      <li>
        <%= link_to new_join_path, class: "row row--link font-semibold text-clay" do %>
          <%= render "shared/add_icon", icon: :join %>
          <%= t(".join") %>
        <% end %>
      </li>
    </ul>
  </section>
</div>
