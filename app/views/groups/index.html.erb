<% content_for :title, t(".title") %>

<h1 class="mt-6 mb-2 text-4xl font-semibold"><%= t(".heading", name: Current.user.name) %></h1>

<% if @groups.any? %>
  <ul class="mt-8 grid gap-4">
    <% @groups.each do |group| %>
      <li class="card"><h2 class="text-2xl font-semibold"><%= group.name %></h2></li>
    <% end %>
  </ul>
<% else %>
  <div class="card mt-8 text-center">
    <h2 class="mb-2 text-2xl font-semibold"><%= t(".empty_heading") %></h2>
    <p class="text-muted"><%= t(".empty") %></p>
  </div>
<% end %>
