<%# locals: (dashboard:) %>
<section id="your-lists" aria-labelledby="your-lists-heading" class="section">
  <%= section_header t(".heading"), id: "your-lists-heading" %>

  <ul class="card card--flush list">
    <% dashboard.lists.each do |list| %>
      <li>
        <%= link_to person_path(list.person), class: "row row--link" do %>
          <%= avatar_tag list.person, size: :sm, tooltip: false %>
          <div class="min-w-0 flex-1">
            <p class="row-title"><%= your_list_title_for(list) %></p>
            <p class="<%= class_names("row-meta", "text-clay": list.wanted_count.zero?) %>"><%= your_list_summary_for(list) %></p>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
