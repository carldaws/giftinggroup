<% shopping_list = Current.user.shopping_list %>
<% to_buy = shopping_list.reject(&:bought?) %>
<% bought = shopping_list.select { it.bought? && !it.given? } %>

<% if to_buy.any? || bought.any? %>
  <section id="shopping-list" aria-labelledby="shopping-list-heading" class="mb-10">
    <h2 id="shopping-list-heading" class="mb-4 text-2xl font-semibold"><%= t(".heading") %></h2>

    <% if to_buy.any? %>
      <ul class="card divide-y divide-line p-0 sm:p-0">
        <% to_buy.each do |reservation| %>
          <% item = reservation.item %>
          <li class="flex items-center gap-4 px-5 py-4 sm:px-6">
            <%= avatar_tag item.owner %>
            <div class="min-w-0 flex-1">
              <%= link_to item.name, person_path(item.owner, anchor: dom_id(item)), class: "font-semibold break-words text-ink underline decoration-line decoration-2 hover:decoration-clay" %>
              <p class="text-base text-muted">
                <% if reservation.occasion.present? && reservation.occasion.person == item.owner %>
                  <%= t(".their_occasion", occasion: reservation.occasion.title, countdown: countdown_to(reservation.occasion.date).downcase_first) %>
                <% elsif reservation.occasion.present? %>
                  <%= t(".for_occasion", name: item.owner.name, occasion: reservation.occasion.title, countdown: countdown_to(reservation.occasion.date).downcase_first) %>
                <% else %>
                  <%= t(".for", name: item.owner.name) %>
                <% end %>
              </p>
              <% if item.received? %>
                <p class="mt-1 text-base font-medium text-honey-ink"><%= t(".already_has", name: item.owner.name) %></p>
              <% end %>
            </div>
            <% if item.received? %>
              <%= button_to t(".let_go"), item_reservation_path(item), method: :delete, class: "button button--quiet button--small shrink-0" %>
            <% else %>
              <%= button_to item_purchase_path(item), class: "button button--quiet button--small shrink-0" do %>
                <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l4 4 8-9"/></svg>
                <%= t(".bought") %>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="card text-muted"><%= t(".all_bought") %></p>
    <% end %>

    <% if bought.any? %>
      <details class="mt-4">
        <summary class="cursor-pointer text-lg font-semibold"><%= t(".bought_count", count: bought.size) %></summary>
        <ul class="mt-3 grid gap-2">
          <% bought.each do |reservation| %>
            <% item = reservation.item %>
            <li class="flex items-center justify-between gap-4 rounded-2xl border border-line bg-card px-5 py-3">
              <span class="min-w-0">
                <span class="text-muted line-through"><%= item.name %></span>
                <span class="block text-base text-muted"><%= t(".for", name: item.owner.name) %></span>
              </span>
              <%= button_to t(".put_back"), item_purchase_path(item), method: :delete, class: "button button--quiet button--small shrink-0" %>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>
  </section>
<% end %>
