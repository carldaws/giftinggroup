<%# locals: (dashboard:) %>
<% if dashboard.shopping? %>
  <section id="shopping-list" aria-labelledby="shopping-list-heading" class="section">
    <%= section_header t(".heading"), id: "shopping-list-heading" %>

    <div class="card card--flush">
      <% if dashboard.to_buy.any? %>
        <ul class="list">
          <% dashboard.to_buy.each do |reservation| %>
            <li class="row">
              <%= avatar_tag reservation.item.owner %>
              <div class="min-w-0 flex-1">
                <%= item_title_link(reservation.item) %>
                <p class="row-meta"><%= shopping_list_occasion_for(reservation) %></p>
                <% if reservation.split? %>
                  <p class="row-meta"><%= splitting_with(reservation) %></p>
                <% end %>
                <%= shopping_list_note_tag(reservation) %>
              </div>
              <% if reservation.joined_by?(Current.user) %>
                <%= button_to t(".leave_split"), item_split_share_path(reservation.item, reservation), method: :delete, class: "button button--secondary button--small" %>
              <% elsif !reservation.item.still_wanted? %>
                <%= button_to t(".let_go"), item_reservation_path(reservation.item), method: :delete, class: "button button--secondary button--small" %>
              <% else %>
                <%= button_to item_purchase_path(reservation.item), class: "button button--secondary button--small" do %>
                  <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l4 4 8-9"/></svg>
                  <%= t(".bought") %>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="row empty"><%= t(".all_bought") %></p>
      <% end %>

      <% if dashboard.bought.any? %>
        <details class="border-t border-line">
          <summary class="row row--link cursor-pointer list-none font-semibold [&::-webkit-details-marker]:hidden">
            <%= t(".bought_count", count: dashboard.bought.size) %>
          </summary>
          <ul class="list border-t border-line">
            <% dashboard.bought.each do |reservation| %>
              <li class="row">
                <div class="min-w-0 flex-1">
                  <p class="text-muted line-through"><%= reservation.item.title %></p>
                  <p class="row-meta"><%= t(".for", name: reservation.item.owner.name) %></p>
                  <% if reservation.split? %>
                    <p class="row-meta"><%= splitting_with(reservation) %></p>
                  <% end %>
                  <% if reservation.item.removed? %>
                    <%= note_tag t(".removed") %>
                  <% end %>
                </div>
                <% if reservation.started_by?(Current.user) && reservation.item.removed? %>
                  <%= button_to t(".let_go"), item_reservation_path(reservation.item), method: :delete, class: "button button--secondary button--small" %>
                <% elsif reservation.started_by?(Current.user) %>
                  <%= button_to t(".put_back"), item_purchase_path(reservation.item), method: :delete, class: "button button--secondary button--small" %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </details>
      <% end %>
    </div>
  </section>
<% end %>
