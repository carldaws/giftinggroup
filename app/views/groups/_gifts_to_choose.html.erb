<% gifts_to_choose = Current.user.gifts_to_choose %>

<% if gifts_to_choose.any? %>
  <div class="mb-10 grid gap-4">
    <% gifts_to_choose.each do |occasion, people| %>
      <section aria-label="<%= t(".label", occasion: occasion_title(occasion)) %>" class="rounded-[1.75rem] bg-honey-tint p-5 text-honey-ink sm:p-6">
        <p class="text-lg font-semibold">
          <%= [ (occasion.group.name unless occasion.birthday?), occasion_title(occasion), countdown_to(occasion.date).downcase_first ].compact.join(" · ") %>
        </p>
        <p class="mt-1">
          <%= t(".still_to_choose_html", names: to_sentence(people.map { link_to it.name, person_path(it), class: "font-semibold underline" })) %>
        </p>
      </section>
    <% end %>
  </div>
<% end %>
