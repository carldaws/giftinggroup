<%# locals: (overview:) %>

<section aria-labelledby="occasions-heading" class="section">
  <%= section_header t(".heading"), id: "occasions-heading" do %>
    <%= link_to t(".holidays"), edit_group_holidays_path(overview.group), class: "button button--secondary button--small" %>
    <%= link_to t(".add"), new_group_occasion_path(overview.group), class: "button button--secondary button--small" %>
  <% end %>

  <% if overview.occasions.any? %>
    <ul class="card card--flush list">
      <% overview.occasions.each do |occasion| %>
        <li class="px-5 py-4 sm:px-6">
          <div class="flex items-center gap-4">
            <%= render "occasions/date_badge", date: occasion.date %>
            <div class="min-w-0 flex-1">
              <p class="row-title"><%= occasion_title(occasion) %></p>
              <p class="row-meta">
                <%= countdown_to(occasion.date) %>
                <% unless occasion.birthday? || occasion.for_everyone_in_group? %>
                  · <%= occasion_people_for(occasion, overview.group) %>
                <% end %>
              </p>
            </div>
            <% if occasion.custom? %>
              <%= link_to t(".edit"), edit_group_occasion_path(overview.group, occasion), class: "button button--secondary button--small",
                    aria: { label: t(".edit_label", name: occasion.title) } %>
            <% end %>
          </div>

          <% if overview.choice_for(occasion).present? %>
            <%= render "occasions/still_to_choose", choice: overview.choice_for(occasion) %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="card empty"><%= t(".empty") %></p>
  <% end %>
</section>
