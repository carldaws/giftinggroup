<%# locals: (group:) %>
<% occasions = Occasion.visible_to(Current.user).for_group(group).upcoming.soonest_first.includes(:person, :creator, :recipients) %>
<% admin = group.admin?(Current.user) %>

<section aria-labelledby="occasions-heading" class="mb-10">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h2 id="occasions-heading" class="text-2xl font-semibold"><%= t(".heading") %></h2>
    <div class="flex flex-wrap gap-2">
      <% if admin %>
        <%= link_to t(".holidays"), edit_group_holidays_path(group), class: "button button--quiet button--small no-underline" %>
      <% end %>
      <%= link_to t(".add"), new_group_occasion_path(group), class: "button button--quiet button--small no-underline" %>
    </div>
  </div>

  <% if occasions.any? %>
    <ul class="card divide-y divide-line p-0 sm:p-0">
      <% occasions.each do |occasion| %>
        <li class="flex items-center gap-4 px-5 py-4 sm:px-6">
          <div class="flex size-12 shrink-0 flex-col items-center justify-center rounded-2xl bg-clay-tint text-clay-ink leading-none">
            <span class="text-lg font-semibold"><%= occasion.date.day %></span>
            <span class="text-xs font-semibold uppercase"><%= l(occasion.date, format: "%b") %></span>
          </div>
          <div class="min-w-0 flex-1">
            <p class="font-semibold break-words"><%= occasion_title(occasion) %></p>
            <p class="text-base text-muted">
              <%= countdown_to(occasion.date) %>
              <% unless occasion.birthday? || occasion.for_everyone_in_group? %>
                <% people = occasion.people_in(group) %>
                · <%= people.any? ? t(".for_people", names: people.map { it == Current.user ? t("groups.membership.you_lowercase") : it.name }.to_sentence) : t(".for_no_one_yet") %>
              <% end %>
            </p>
          </div>
          <% if occasion.editable_by?(Current.user, admin:) %>
            <%= link_to t(".edit"), edit_group_occasion_path(group, occasion), class: "button button--quiet button--small no-underline",
                  aria: { label: t(".edit_label", name: occasion.title) } %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="card text-muted"><%= t(".empty") %></p>
  <% end %>
</section>
