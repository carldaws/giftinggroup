<%# locals: (dashboard:) %>
<% if dashboard.unread_chats.any? %>
  <section aria-labelledby="unread-heading" class="section">
    <%= section_header t(".heading"), id: "unread-heading" %>

    <ul class="card card--flush list">
      <% dashboard.unread_chats.each do |chat| %>
        <li>
          <%= link_to polymorphic_path([ chat.group, chat.subject, :messages ].compact, anchor: "new"), data: { turbo_prefetch: false }, class: "row row--link" do %>
            <% if chat.about_someone? %>
              <%= avatar_tag chat.subject.user, tooltip: false %>
            <% end %>
            <span class="min-w-0 flex-1">
              <span class="row-title block"><%= unread_chat_title(chat) %></span>
              <span class="row-meta block truncate"><%= chat.latest.author_name %>: <%= chat.latest.body %></span>
              <% if chat.about_someone? %>
                <span class="row-meta block"><%= chat.group.name %></span>
              <% end %>
            </span>
            <span class="count">
              <span aria-hidden="true"><%= chat.messages.size %></span>
              <span class="sr-only"><%= t(".count", count: chat.messages.size) %></span>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
