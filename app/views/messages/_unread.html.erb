<% unread = Message.unread_by(Current.user).includes(:author, subject: %i[ user group ]).chronologically.group_by(&:subject) %>

<% if unread.any? %>
  <section aria-labelledby="unread-heading" class="section">
    <%= section_header t(".heading"), id: "unread-heading" %>

    <ul class="card card--flush list">
      <% unread.sort_by { |_, messages| messages.last.created_at }.reverse_each do |membership, messages| %>
        <% latest = messages.last %>
        <li>
          <%= link_to group_membership_messages_path(membership.group, membership, anchor: "new"), data: { turbo_prefetch: false }, class: "row row--link" do %>
            <%= avatar_tag membership.user, tooltip: false %>
            <span class="min-w-0 flex-1">
              <span class="row-title block"><%= t(".about", name: membership.user.name) %></span>
              <span class="row-meta block truncate"><%= latest.author_name %>: <%= latest.body %></span>
              <span class="row-meta block"><%= membership.group.name %></span>
            </span>
            <span class="count">
              <span aria-hidden="true"><%= messages.size %></span>
              <span class="sr-only"><%= t(".count", count: messages.size) %></span>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
