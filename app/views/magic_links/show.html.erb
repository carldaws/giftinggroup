<% content_for :title, t(".title") %>

<div class="mx-auto max-w-md text-center">
  <% if @magic_link.present? %>
    <h1 class="mb-3 text-4xl font-semibold leading-tight"><%= t(".heading") %></h1>
    <p class="mb-8 text-muted">
      <%= t(".signing_in_as_html", email_address: tag.strong(@magic_link.email_address, class: "font-semibold text-ink")) %>
    </p>

    <%= button_to t(".submit"), magic_link_redemption_path(@magic_link.token), class: "button w-full" %>
  <% else %>
    <h1 class="mb-3 text-4xl font-semibold leading-tight"><%= t(".expired_heading") %></h1>
    <p class="mb-8 text-muted"><%= t(".expired", minutes: MagicLink::LIFETIME.in_minutes.to_i) %></p>

    <%= link_to t(".start_again"), new_session_path, class: "button w-full" %>
  <% end %>
</div>
